# Salin ke .env.local lalu isi. Jangan commit .env.local.

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL situs untuk tautan email dan redirect Google (tanpa garis miring di akhir)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase service role (hanya server, jangan pernah NEXT_PUBLIC_). Project Settings -> API
SUPABASE_SERVICE_ROLE_KEY=
